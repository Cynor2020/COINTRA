NODE_ENV=development
PORT=5000
# For local MongoDB installation, make sure MongoDB is running on your system
# Download from: https://www.mongodb.com/try/download/community
# Or use MongoDB Atlas (cloud) - replace with your Atlas connection string
MONGO_URI=mongodb://localhost:27017/cointra
JWT_SECRET=cointra_jwt_secret_key_12345

# If using MongoDB Atlas, your connection string will look like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cointra